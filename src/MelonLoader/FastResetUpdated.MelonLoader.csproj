<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>BetterBonk</AssemblyName>
    <RootNamespace>BetterBonk.MelonLoader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared game logic lives in ..\Shared and has no project of its own — it is
         compiled straight into this assembly against MelonLoader's own copy of the game's
         interop types. The BepInEx project compiles the exact same files against its own
         copy instead, so both builds share one source of truth without ever having to treat
         one loader's interop DLLs as compatible with the other's. -->
    <Compile Include="..\Shared\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDir)\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderDir)\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(MelonLoaderDir)\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Toggle Everything presets read/write SaveManager.Instance.progression.inactivated, which
         is an Il2CppSystem.Collections.Generic.HashSet<string> (confirmed via signature lookup
         against Assembly-CSharp.dll) — that generic type itself lives in this assembly, not
         Il2Cppmscorlib, confirmed by the exact build error naming it. -->
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(MelonLoaderDir)\Il2CppAssemblies\Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(MelonLoaderDir)\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MelonLoaderDir)\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(MelonLoaderDir)\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(MelonLoaderDir)\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(MelonLoaderDir)\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Needed by Personal Leaderboard's TMP_Text label and Button/onClick usage. The TextMeshPro
         interop DLL keeps Unity's own assembly filename (Unity.TextMeshPro.dll) even though the
         C# namespace it exposes is Il2CppTMPro — confirmed against the actual Il2CppAssemblies
         folder contents. UnityEngine.UI.dll's filename matches its namespace directly. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(MelonLoaderDir)\Il2CppAssemblies\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(MelonLoaderDir)\Il2CppAssemblies\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Toggle Everything reuses this compiled DLL directly (author-authorized exact-code
         reuse — see ModToggleEverything.cs for why this wasn't hand-transcribed instead), but
         rather than shipping it as a second, separately-placed file, it's embedded straight into
         this assembly and loaded from memory at runtime (ModToggleEverything.cs,
         LoadEmbeddedToggleEverythingAssembly). LogicalName is pinned to a fixed string so the
         loading code doesn't need to know which project (and therefore which default namespace)
         embedded it. -->
    <EmbeddedResource Include="..\..\lib\MegabonkToggleEverything.dll">
      <LogicalName>MegabonkToggleEverything.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Drop the built mod straight into the game's Mods folder once MelonLoaderDir is set
       in FastReset.local.props, so "build" is the whole install step. This is now the ONLY
       file that needs installing — MegabonkToggleEverything.dll is embedded inside it (see the
       EmbeddedResource item above), so there's no separate UserLibs step anymore. -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="'$(MelonLoaderDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MelonLoaderDir)\..\Mods" SkipUnchangedFiles="true" />
  </Target>

</Project>
